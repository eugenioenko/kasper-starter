<template>
  <div class="example">
    <header class="example-header">
      <h2>Examples</h2>
    </header>

    <div class="example-grid">
      <section class="card">
        <h3>Signal</h3>
        <p class="count-display">Count: <strong>{{count.value}}</strong></p>
        <div class="button-group">
          <button @on:click="increment()">Increment</button>
          <button class="secondary" @on:click="reset()">Reset</button>
        </div>
      </section>

      <section class="card">
        <h3>If / Else</h3>
        <div class="badge-container">
          <p @if="count.value > 5" class="badge badge--high">High Count (> 5)</p>
          <p @elseif="count.value > 0" class="badge badge--mid">Mid Count (1-5)</p>
          <p @else class="badge badge--zero">Zero Count</p>
        </div>
      </section>

      <section class="card">
        <h3>Each</h3>
        <ul class="item-list">
          <li @each="item of items.value" class="list-item">
            <span class="dot"></span>
            {{item}}
          </li>
        </ul>
        <button class="add-button" @on:click="addItem()">Add Item</button>
      </section>

      <section class="card">
        <h3>Two-Way Binding</h3>
        <div class="form-group">
          <label for="name-input">Name</label>
          <input 
            id="name-input"
            type="text" 
            placeholder="Type your name..."
            @value="name.value" 
            @on:input="name.value = $event.target.value" 
          />
        </div>
        <p class="preview-text">Hello, <strong>{{name.value || 'stranger'}}</strong>!</p>
      </section>
    </div>
  </div>
</template>

<script>
import { Component, signal } from 'kasper-js';

export class Example extends Component {
  count = signal(0);
  items = signal(['Apple', 'Banana', 'Cherry']);
  name = signal("John Doe");

  increment() {
    this.count.value++;
  }

  reset() {
    this.count.value = 0;
  }

  addItem() {
    const next = ['Date', 'Elderberry', 'Fig', 'Grape', 'Honeydew'];
    const i = this.items.value.length - 3;
    this.items.value = [...this.items.value, next[i % next.length]];
  }
}
</script>

<style>
