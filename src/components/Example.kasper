  background: #1a1c1e;
  border: 1px solid #2a2d2f;
  border-radius: 12px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.card:hover {
  border-color: #3a3d3f;
}

.card h3 {
  font-size: 0.75rem;
  color: #d41d67;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 1.25rem;
  font-weight: 700;
}

.count-display {
  font-size: 1.5rem;
  margin-bottom: 1.25rem;
}

.count-display strong {
  color: #fff;
}

.button-group {
  display: flex;
  gap: 0.75rem;
  margin-top: auto;
}

.example button {
  flex: 1;
  padding: 0.6rem 1rem;
  background: #d41d67;
  border: none;
  border-radius: 6px;
  color: white;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: opacity 0.2s, transform 0.1s;
}

.example button:hover {
  opacity: 0.9;
}

.example button:active {
  transform: translateY(1px);
}

.example button.secondary {
  background: #2a2d2f;
  color: #ccc;
}

.example button.secondary:hover {
  background: #3a3d3f;
  color: #fff;
}

.badge-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60px;
}

.badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  text-align: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.badge--high { background: #d41d67; color: white; }
.badge--mid  { background: #1a2a0d; color: #6abf40; border: 1px solid #2a3d1d; }
.badge--zero { background: #2a2d2f; color: #aaa; }

.item-list {
  list-style: none;
