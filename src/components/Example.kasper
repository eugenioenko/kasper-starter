  border-bottom: 1px solid #232527;
  color: #ccc;
}

.list-item:last-child {
  border-bottom: none;
}

.dot {
  width: 6px;
  height: 6px;
  background: #d41d67;
  border-radius: 50%;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.form-group label {
  font-size: 0.8rem;
  color: #888;
